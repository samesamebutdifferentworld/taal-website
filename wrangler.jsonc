{
  "name": "taal-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "kv_namespaces": [
    { "binding": "LICENCES", "id": "fc1426bc38504f78b52e0bf054e18250" },
    // People who built a demo (kept for a year).
    { "binding": "ENQUIRIES", "id": "8420623ed9644cc58548c5131084201f" }
  ],
  // The booking app builds the demos. This connection can't be reached from the internet.
  "services": [{ "binding": "BOOKING", "service": "booking", "entrypoint": "DemoBuilder" }],
  "vars": {
    // Where the demos live.
    "BOOKING_URL": "https://booking.tjallan13.workers.dev",
    // Where new demos are reported, and the reply-to on emails to studios.
    "CONTACT_EMAIL": "",
    // The sender, on a domain verified in Resend, e.g. "Tim at Taal <hello@yourdomain.com>".
    "EMAIL_FROM": "",
    // Booking link for a call (Calendly, Cal.com or Zoom Scheduler). Empty: "reply to book a call".
    "CALL_URL": ""
  }
  // Secrets, set in Cloudflare (Worker > Settings > Variables and secrets), never in this file:
  //   RESEND_API_KEY   sends the emails
  //   ADMIN_KEY        a long random string: signs you in to /admin.html
}
